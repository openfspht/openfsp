    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
