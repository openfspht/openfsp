#!/bin/sh
set -eu

APP=/opt/openfsp/app.jar

usage() {
    cat <<'USAGE'
Usage: gateway [command]

Commands:
  serve    start the gateway (default)
  hash     read an admin token and print the Argon2id hash to set as OPENFSP_ADMIN_TOKEN
  help     show this help
USAGE
}

case "${1:-serve}" in
    serve)
        [ "$#" -eq 0 ] || shift
        exec java -jar "$APP" "$@"
        ;;
    help | -h | --help)
        usage
        ;;
    -*)
        exec java -jar "$APP" "$@"
        ;;
    hash)
        shift
        [ "$#" -eq 0 ] || { usage >&2; exit 64; }
        exec java -XX:TieredStopAtLevel=1 -jar "$APP" hash
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
