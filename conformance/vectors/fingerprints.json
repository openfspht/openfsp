      "canonical": "{\"payer\":{\"metadata\":\"caf\u00e9\"}}",
      "fingerprint": "3af4180541a6487b1c9df8ab46947a098a7e03aeb84042eaf38579165ac87ac8"
    },
    {
      "name": "integers are written without exponent or fraction",
