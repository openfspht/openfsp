{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfsp.org/conformance/schemas/common.json",
  "$defs": {
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "HTG"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "phone_number": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{1,14}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "capability_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,40}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "fee": {
      "type": "object",
      "required": [
        "amount",
        "bearer"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/money"
        },
        "bearer": {
          "enum": [
            "merchant",
            "payer"
          ]
        }
      }
    },
    "absolute_url": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "payment_status": {
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "expired",
        "canceled"
      ]
    },
    "locale": {
      "enum": [
        "fr",
        "ht",
        "en"
      ]
    },
    "payer": {
      "type": "object",
      "required": [
        "phone_number"
      ],
      "properties": {
        "phone_number": {
          "$ref": "#/$defs/phone_number"
        }
      }
    }
  }
}
