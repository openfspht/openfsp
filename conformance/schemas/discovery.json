{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfsp.org/conformance/schemas/discovery.json",
  "type": "object",
  "required": [
    "issuer",
    "protocol_version",
    "capabilities_supported"
  ],
  "properties": {
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://.*[^/]$"
    },
    "protocol_version": {
      "type": "string"
    },
    "api_base": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "payments_endpoint": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "capabilities_endpoint": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "statements_endpoint": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "webhook_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kid",
          "kty"
        ],
        "allOf": [
          {
            "if": { "properties": { "kty": { "const": "OKP" } }, "required": ["kty"] },
            "then": {
              "required": ["crv", "x"],
              "properties": { "crv": { "const": "Ed25519" }, "alg": { "const": "EdDSA" } }
            }
          },
          {
            "if": { "properties": { "kty": { "const": "EC" } }, "required": ["kty"] },
            "then": {
              "required": ["crv", "x", "y"],
              "properties": { "crv": { "const": "P-256" }, "alg": { "const": "ES256" } }
            }
          }
        ],
        "properties": {
          "kid": {
            "type": "string"
          },
          "kty": {
            "type": "string"
          },
          "crv": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "x": {
            "type": "string"
          },
          "y": {
            "type": "string"
          },
          "openfsp_status": {
            "enum": [
              "active",
              "retired"
            ]
          }
        }
      }
    },
    "authentication_methods_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scopes_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities_supported": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/capability_name"
      },
      "contains": {
        "const": "payments"
      }
    },
    "webhook_signature_algorithms_supported": {
      "type": "array",
      "items": {
        "enum": [
          "ed25519",
          "ecdsa-p256-sha256"
        ]
      }
    },
    "conformance_endpoint": {
      "$ref": "common.json#/$defs/absolute_url"
    }
  },
  "patternProperties": {
    "_endpoint$": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "_uri$": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "_supported$": {
      "type": "array"
    }
  }
}
