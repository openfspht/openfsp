{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfsp.org/conformance/schemas/problem.json",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "retryable",
    "effect",
    "request_id"
  ],
  "properties": {
    "type": {
      "$ref": "common.json#/$defs/absolute_url"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "instance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "effect": {
      "enum": [
        "none",
        "unknown"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "errors": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field_error"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "min_amount": {
      "$ref": "common.json#/$defs/money"
    },
    "max_amount": {
      "$ref": "common.json#/$defs/money"
    },
    "amount_step": {
      "$ref": "common.json#/$defs/money"
    }
  },
  "$defs": {
    "field_error": {
      "type": "object",
      "required": [
        "field",
        "code"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(/([^~]|~[01])*)*$"
        },
        "code": {
          "enum": [
            "required",
            "malformed",
            "invalid_type",
            "unknown_field",
            "not_positive",
            "too_large",
            "too_long",
            "too_many",
            "not_allowed"
          ]
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
