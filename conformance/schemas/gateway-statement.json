{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfsp.org/conformance/schemas/gateway-statement.json",
  "type": "object",
  "required": [
    "provider",
    "business_date",
    "final",
    "payments",
    "totals"
  ],
  "properties": {
    "provider": {
      "$ref": "common.json#/$defs/provider_id"
    },
    "business_date": {
      "$ref": "common.json#/$defs/date"
    },
    "final": {
      "type": "boolean"
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "payment",
          "reference",
          "status",
          "amount",
          "completed_at"
        ],
        "properties": {
          "payment": {
            "$ref": "common.json#/$defs/resource_id"
          },
          "reference": {
            "$ref": "common.json#/$defs/reference"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "expired",
              "canceled"
            ]
          },
          "amount": {
            "$ref": "common.json#/$defs/money"
          },
          "completed_at": {
            "$ref": "common.json#/$defs/timestamp"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "succeeded",
          "failed",
          "expired",
          "canceled"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "count",
          "amount"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "amount": {
            "$ref": "common.json#/$defs/money"
          }
        }
      }
    }
  }
}
