{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfsp.org/conformance/schemas/statement.json",
  "allOf": [
    {
      "$ref": "collection.json"
    }
  ],
  "properties": {
    "data": {
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "provider",
        "business_date",
        "booked_at",
        "amount"
      ],
      "properties": {
        "provider": {
          "$ref": "common.json#/$defs/provider_id"
        },
        "business_date": {
          "$ref": "common.json#/$defs/date"
        },
        "booked_at": {
          "$ref": "common.json#/$defs/timestamp"
        },
        "amount": {
          "$ref": "common.json#/$defs/money"
        },
        "fee": {
          "$ref": "common.json#/$defs/fee"
        },
        "payment": {
          "$ref": "common.json#/$defs/resource_id"
        },
        "reference": {
          "$ref": "common.json#/$defs/reference"
        }
      }
    }
  }
}
