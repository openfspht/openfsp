server {
    listen 8080;
    root /usr/share/nginx/html;

    location /gateway/ {
        proxy_pass http://gateway:8080/;
        proxy_set_header Authorization "Bearer ${OPENFSP_ADMIN_TOKEN}";
    }

    location /simulator/ {
        proxy_pass http://simulator:8090/;
    }

    location / {
        try_files $uri /index.html;
    }
}
